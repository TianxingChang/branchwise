{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "vcs": {
    "enabled": true,
    "useIgnoreFile": true,
    "defaultBranch": "main",
    "clientKind": "git"
  },
  "files": {
    "ignoreUnknown": true,
    // .claude/worktrees holds parallel-session checkouts with their own root
    // configs; scanning into them makes Biome refuse to run at all.
    "includes": ["!**/node_modules", "!**/*.d.ts", "!**/ui", "!**/.claude"]
  },
  "javascript": {
    "globals": ["MAIN_WINDOW_VITE_DEV_SERVER_URL", "MAIN_WINDOW_VITE_NAME"]
  }
}
